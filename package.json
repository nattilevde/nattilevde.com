{
  "name": "nattilevde",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A stylised 3D open-world exploration game set in Kerala, plus an illustrated portal covering all 14 districts.",
  "license": "MIT",
  "author": "Muhammed Nabeel",
  "homepage": "https://nattilevde.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nattilevde/nattilevde.com"
  },
  "bugs": {
    "url": "https://github.com/nattilevde/nattilevde.com/issues"
  },
  "keywords": [
    "kerala",
    "exploration-game",
    "open-world",
    "threejs",
    "react",
    "vite",
    "webgl",
    "web-audio"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-seo.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:release": "npm run build && node scripts/check-seo.mjs && playwright test --config playwright.release.config.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "3.4.2",
    "vite": "^6.1.0",
    "wrangler": "^4.129.1"
  }
}
